<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cristopher.productos.controller.ProductoController">
    <top>
        <VBox spacing="10">
            <padding><Insets bottom="12" left="15" right="15" top="15" /></padding>
            <Label text="GESTIÓN DE PRODUCTOS" />
            <HBox spacing="10">
                <TextField fx:id="txtBuscar" prefWidth="340" promptText="Buscar por código, nombre o categoría" />
                <ComboBox fx:id="cbEstado" prefWidth="130" />
                <ComboBox fx:id="cbFiltroCategoria" prefWidth="190" />
                <Label fx:id="lblResultado" text="Mostrando 0 productos" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblProductos">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="90" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="190" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="140" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="100" text="Precio" />
                <TableColumn fx:id="colExistencia" prefWidth="90" text="Existencia" />
                <TableColumn fx:id="colActivo" prefWidth="80" text="Activo" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="320" spacing="12">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
            <Label text="FORMULARIO" />
            <GridPane hgap="10" vgap="10">
                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbCategoria" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtExistencia" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Activo:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <CheckBox fx:id="chkActivo" text="Producto activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <HBox spacing="8">
                <Button fx:id="btnGuardar" onAction="#guardarProducto" text="Guardar" />
                <Button fx:id="btnActualizar" disable="true" onAction="#actualizarProducto" text="Actualizar" />
                <Button onAction="#limpiarFormulario" text="Limpiar" />
            </HBox>
            <Button fx:id="btnEliminar" disable="true" onAction="#eliminarProducto" text="Eliminar" />
        </VBox>
    </right>
</BorderPane>
