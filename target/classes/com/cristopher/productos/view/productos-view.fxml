<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cristopher.productos.controller.ProductoController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="12" left="15"/></padding>
            <Label text="GESTIÓN DE PRODUCTOS"/>
            <Label text="Etapa 70% - CRUD completo"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tblProductos">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="190"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="90"/>
                <TableColumn fx:id="colActivo" text="Activo" prefWidth="80"/>
            </columns>
        </TableView>
    </center>
    <right>
        <VBox spacing="12" prefWidth="320">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="FORMULARIO"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Categoría:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCategoria" prefWidth="180" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Precio:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPrecio" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Existencia:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtExistencia" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Activo:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkActivo" text="Producto activo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="8">
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarProducto"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizarProducto" disable="true"/>
            </HBox>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarProducto" disable="true"/>
        </VBox>
    </right>
</BorderPane>
